<style>
/* TRMNL X Full Landscape: 1040 x 780 logical px -> 1872 x 1404 physical px.
   Design reference: family preview of 23 Nov 2026. Flat grayscale, no gradients. */
.fx,.fx *{box-sizing:border-box}
.fx{
  display:flex;flex-direction:column;width:100%;height:100%;min-height:0;
  padding:34px 42px 11px;background:#fff;color:#111;
  font-family:Arial,Helvetica,sans-serif;font-variant-numeric:tabular-nums;
  overflow:hidden
}
.fx__top{
  height:154px;min-height:154px;display:flex;align-items:flex-start;
  justify-content:space-between;gap:16px;border-bottom:3px solid #111
}
.fx__date-block{min-width:0}
.fx__weekday{
  color:#666;font-size:17px;font-weight:800;letter-spacing:.02em;
  text-transform:uppercase;line-height:23px
}
.fx__date{
  margin-top:10px;font-size:76px;line-height:1;letter-spacing:-.045em;
  font-weight:800;white-space:nowrap
}
.fx__year{
  margin-top:8px;color:#666;font-size:16px;line-height:19px;
  font-weight:700;letter-spacing:.025em;text-transform:uppercase
}
/* Only the two sun times occupy the upper-right header: no greeting/banner. */
.fx__sun{
  margin-top:18px;display:flex;justify-content:flex-end;gap:0;
  flex:0 0 auto;min-width:0;text-align:right
}
.fx__sun-item{min-width:126px;display:flex;flex-direction:column;align-items:flex-end;gap:7px}
.fx__sun-item + .fx__sun-item{margin-left:15px;padding-left:15px;border-left:1px solid #bbb}
.fx__sun-label{font-size:13px;font-weight:700;letter-spacing:.015em;text-transform:uppercase;color:#666;white-space:nowrap}
.fx__sun-value{display:flex;align-items:center;justify-content:flex-end;gap:7px;font-size:29px;line-height:1;font-weight:800;white-space:nowrap}
.fx__sun-value svg{width:27px;height:27px;flex:0 0 27px;stroke:#111}
.fx__birthday{
  flex:none;height:70px;min-height:70px;margin-top:15px;
  display:flex;align-items:center;justify-content:space-between;gap:20px;
  border-radius:5px;background:#eee;padding:11px 18px
}
.fx__birthday-primary{min-width:0;flex:1}
.fx__birthday-title{font-size:15px;font-weight:800;color:#666;letter-spacing:.015em;line-height:20px}
.fx__birthday-body{
  display:block;margin-top:1px;font-size:21px;font-weight:700;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:28px
}
.fx__birthday-side{
  font-size:17px;line-height:22px;color:#666;white-space:nowrap;
  max-width:42%;overflow:hidden;text-overflow:ellipsis;text-align:right
}
.fx__main{
  display:grid;grid-template-columns:minmax(0,60%) minmax(0,40%);
  flex:1;min-height:0;margin-top:24px;border-top:2px solid #111
}
.fx__agenda{
  display:flex;flex-direction:column;min-height:0;min-width:0;
  padding:14px 27px 0 0;overflow:hidden
}
.fx__heading{display:flex;align-items:baseline;justify-content:space-between;gap:8px;min-width:0}
.fx__section{
  font-size:16px;line-height:22px;letter-spacing:-.015em;
  font-weight:800;text-transform:uppercase
}
.fx__hint{color:#666;font-size:13px;font-weight:500;white-space:nowrap;text-transform:uppercase}
.fx__events{flex:1;min-height:0;overflow:hidden;margin-top:15px}
.fx__event{
  display:grid;grid-template-columns:90px minmax(0,1fr) 47px;
  gap:10px;align-items:center;min-height:57px;
  border-bottom:1px solid #bbb
}
.fx__event-time{font-size:20px;font-weight:800;white-space:nowrap}
.fx__event-title{
  font-size:21px;font-weight:500;min-width:0;max-width:100%;
  line-height:1.24;overflow:hidden;text-overflow:ellipsis;white-space:nowrap
}
.fx__event-owner{
  display:block;justify-self:end;min-width:37px;max-width:47px;
  border-radius:5px;padding:7px 4px;background:#eee;
  text-align:center;font-size:16px;line-height:20px;font-weight:700
}
.fx__noevents{font-size:19px;color:#666;padding:26px 0}
.fx__overflow{margin-top:8px;color:#666;font-size:13px}
.fx__side{
  min-width:0;display:flex;flex-direction:column;
  padding:14px 0 0 22px;border-left:1px solid #aaa;overflow:hidden
}
.fx__weather{flex:none;min-height:0;overflow:hidden}
.fx__period-header{display:flex;align-items:baseline;justify-content:space-between;gap:6px}
.fx__range{
  margin-top:19px;font-size:60px;font-weight:800;line-height:1;
  letter-spacing:-.045em;white-space:nowrap
}
.fx__description{font-size:21px;line-height:1.2;font-weight:700;margin-top:9px}
.fx__meta{color:#666;font-size:14px;line-height:19px;margin-top:5px}
.fx__ways{border-top:1px solid #bbb;margin-top:4px;padding-top:15px}
.fx__ways-title{font-size:14px;font-weight:800;text-transform:uppercase;line-height:20px}
.fx__route{
  display:grid;grid-template-columns:90px minmax(0,1fr);align-items:center;
  gap:10px;min-height:34px;padding:5px 8px;margin-top:4px;
  font-size:16px;line-height:22px
}
.fx__route--possible,.fx__route--expected{background:#ddd;border-radius:3px}
.fx__route-time{font-size:16px;font-weight:800;white-space:nowrap}
.fx__route-text{font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.fx__route--expected .fx__route-text{font-weight:800}
.fx__trash{
  flex:1;min-height:0;min-width:0;overflow:hidden;
  border-top:1px solid #bbb;margin-top:14px;padding-top:14px
}
.fx__bins{margin-top:10px}
.fx__bin{
  display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;
  gap:8px;min-height:44px;border-bottom:1px solid #bbb
}
.fx__bin-name{font-size:18px;font-weight:650;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.fx__bin-date{font-size:16px;font-weight:500;white-space:nowrap}
.fx__warning{color:#666;font-size:15px;line-height:1.3;margin-top:13px}
.fx__foot{
  flex:none;display:flex;justify-content:space-between;align-items:center;
  gap:12px;height:21px;margin-top:12px;border-top:1px solid #bbb;
  color:#777;font-size:12px;font-weight:500;white-space:nowrap
}
</style>