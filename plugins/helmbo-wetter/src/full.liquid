<style>
.fano, .fano * { box-sizing: border-box; }
.fano { width: 800px; height: 480px; padding: 18px 26px 13px; background: #fff; color: #000;
  font: 16px Arial, sans-serif; font-variant-numeric: tabular-nums; display: grid;
  grid-template-rows: 49px 119px 175px 65px 21px; }
.fano header, .fano footer { display: flex; align-items: center; justify-content: space-between; }
.fano header { border-bottom: 3px solid; display: grid; grid-template-columns: 250px minmax(0, 1fr) 196px; column-gap: 12px; align-items: center; }
.fano h1 { font-size: 32px; line-height: 1; margin: 0; font-weight: 800; }
.fano h1 span { font-size: 19px; margin-left: 12px; font-weight: 500; }
.fano header h1 { white-space: nowrap; }
.fano .sun-times { display: flex; align-items: center; justify-content: center; gap: 16px; white-space: nowrap; }
.fano .updated-block { border-left: 1px solid #000; padding-left: 12px; text-align: right; min-width: 0; }
.fano .updated-date { display: block; font-size: 21px; font-weight: 800; letter-spacing: .1px; line-height: 1.1; white-space: nowrap; }
.fano .updated-time { display: block; margin-top: 3px; font-size: 11px; font-weight: 600; line-height: 1.1; white-space: nowrap; }
.fano .sun-time { display: inline-flex; gap: 5px; align-items: center; font-size: 16px; }
.fano .sun-time svg { display: block; width: 28px; height: 28px; flex: 0 0 28px; }
.fano .sun-time strong { font-weight: 800; }
.fano .caps { font-size: 13px; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; }
.fano .now { display: grid; grid-template-columns: 215px 315px 1fr; align-items: center; }
.fano .now > div { padding: 0 15px; border-left: 1px solid; }
.fano .now > div:first-child { border: 0; padding-left: 0; }
.fano .reading { display: block; font-size: 51px; font-weight: 800; line-height: 1; margin: 3px 0; }
.fano .now small { font-size: 16px; font-weight: 600; }
.fano .wind-pair { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.fano .wind-pair .reading { font-size: 40px; }
.fano .wind-pair small, .fano .reading small { font-size: 17px; }
.fano .windrose { width: 86px; flex: 0 0 86px; display: flex; align-items: center; flex-direction: column; gap: 0; }
.fano .windrose svg { display: block; width: 78px; height: 73px; }
.fano .windrose .dir { font-size: 14px; font-weight: 800; line-height: 1; }
.fano table { border-collapse: collapse; width: 100%; table-layout: fixed; line-height: 1; }
.fano th, .fano td { text-align: left; border-bottom: 1px solid; padding: 0 6px; white-space: nowrap; overflow: hidden; text-overflow: clip; }
.fano th { background: #000; color: #fff; height: 25px; font-size: 12px; }
.fano td { font-size: 15px; height: 30px; }
.fano td:first-child { font-weight: 750; }
.fano td.rain-cell { font-size: 14px; letter-spacing: -.2px; }
.fano td span { font-size: 13px; font-weight: 400; margin-left: 5px; }
.fano .coast { display: grid; grid-template-columns: 1fr 1fr 1.25fr; align-items: center; }
.fano .coast > div { border-left: 1px solid; padding-left: 14px; }
.fano .coast > div:first-child { border: 0; padding-left: 0; }
.fano .coast strong { display: inline-block; margin-top: 2px; font-size: 27px; line-height: 1; }
.fano .coast small { font-size: 14px; margin-left: 6px; }
.fano footer { border-top: 1px solid; font-size: 12px; }
</style>
<main class="fano">
  <header>
    <h1>Fanø<span>{{ place | escape }}</span></h1>
    <div class="sun-times" aria-label="Sonnenaufgang und Sonnenuntergang">
      <span class="sun-time" title="Sonnenaufgang" aria-label="Sonnenaufgang {{ sunrise }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M1.5 18H16.5 M3.5 18a6 6 0 0 1 12 0 M20 16V5 M17 8l3-3 3 3"/>
        </svg><strong>{{ sunrise }}</strong>
      </span>
      <span class="sun-time" title="Sonnenuntergang" aria-label="Sonnenuntergang {{ sunset }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M1.5 18H16.5 M3.5 18a6 6 0 0 1 12 0 M20 5V16 M17 13l3 3 3-3"/>
        </svg><strong>{{ sunset }}</strong>
      </span>
    </div>
    <div class="updated-block">
      <strong class="updated-date">{{ updated_date | escape }}</strong>
      <span class="updated-time">Letzte Aktualisierung: {{ updated_time | escape }} Uhr</span>
    </div>
  </header>
  <section class="now" aria-label="Aktuelles Wetter">
    <div><div class="caps">Temperatur</div><strong class="reading">{{ temp }}<small> °C</small></strong><small>Gefühlt {{ feels }} °C</small></div>
    <div class="wind-pair">
      <div><div class="caps">Wind</div><strong class="reading">{{ wind }}</strong><small>Bft</small></div>
      <div><div class="caps">Böen</div><strong class="reading">{{ gust }}</strong><small>Bft</small></div>
      <div class="windrose" aria-label="Wind aus {{ wind_dir }}">
        <svg viewBox="0 0 90 84" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Windrichtung {{ wind_dir }}">
          <circle cx="45" cy="42" r="25" fill="none" stroke="#000" stroke-width="1.5"/>
          <path d="M45 15V19 M45 65V69 M18 42H22 M68 42H72" fill="none" stroke="#000" stroke-width="1.5"/>
          <g font-family="Arial, sans-serif" font-size="11" font-weight="700" fill="#000" text-anchor="middle">
            <text x="45" y="11">N</text><text x="81" y="46">O</text>
            <text x="45" y="82">S</text><text x="9" y="46">W</text>
          </g>
          {% if wind_deg != nil %}
          <g transform="rotate({{ wind_deg }}, 45, 42)">
            <path d="M45 21 L38 40 L45 35 L52 40 Z" fill="#000"/>
            <path d="M45 36V62" stroke="#000" stroke-width="2"/>
          </g>
          {% else %}
          <text x="45" y="47" font-size="16" text-anchor="middle">–</text>
          {% endif %}
          <circle cx="45" cy="42" r="2.5" fill="#000"/>
        </svg>
        <span class="dir">{{ wind_dir }}</span>
      </div>
    </div>
    <div><div class="caps">Niederschlag</div><strong class="reading">{{ rain }}<small> mm</small></strong><small>{{ rain_label }} Uhr</small></div>
  </section>
  <table aria-label="Wettervorhersage">
    <colgroup><col style="width:25%"><col style="width:16%"><col style="width:18%"><col style="width:21%"><col style="width:20%"></colgroup>
    <thead><tr><th>ZEITRAUM</th><th>WETTER</th><th>TEMPERATUR</th><th>NIEDERSCHLAG</th><th>WIND / BÖEN</th></tr></thead>
    <tbody>
    {% for row in today %}
      <tr><td>{{ row.label }}<span>{{ row.detail }}</span></td><td>{{ row.sky }}</td><td>{{ row.temp }}</td><td class="rain-cell">{{ row.rain }}</td><td>{{ row.wind }}</td></tr>
    {% endfor %}
    {% for row in days %}
      <tr><td>{{ row.label }}{% if row.mixed %}*{% endif %}<span>{{ row.detail }}</span></td><td>{{ row.sky }}</td><td>{{ row.temp }}</td><td class="rain-cell">{{ row.rain }}</td><td>{{ row.wind }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  <section class="coast" aria-label="Gezeiten und Wassertemperatur">
    <div><div class="caps">Nächste Ebbe · Nordby</div><strong>{{ ebb }}</strong><small>{{ ebb_day }}</small></div>
    <div><div class="caps">Nächste Flut · Nordby</div><strong>{{ flood }}</strong><small>{{ flood_day }}</small></div>
    <div><div class="caps">Wasser · Esbjerg Havn</div><strong>{{ water }} °C</strong>{% if water_time %}<small>{{ water_time }} Uhr</small>{% endif %}</div>
  </section>
  <footer><span>{{ current_source | escape }} · DMI-Gezeiten{% if mixed %} · * Modellmix{% endif %}</span><span>Regen-%: max. Stunde · {% if missing.size > 0 %}Datenlücken{% else %}DMI/Open-Meteo{% endif %}</span></footer>
</main>
