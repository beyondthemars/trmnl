<style>
/* Wetter Fanø – half vertical / TRMNL OG (400 × 480). Same transform.py data as full.liquid. */
.layout.fn-half-v, .fn-half-v, .fn-half-v * { box-sizing: border-box; }
.layout.fn-half-v {
  width: 100%; height: 100%; min-width: 0; min-height: 0; margin: 0; padding: 0;
  display: grid; grid-template-rows: 41px 89px 47px minmax(0, 1.24fr) minmax(0, 0.94fr) 52px 13px;
  overflow: hidden; background: #fff; color: #000;
  font: 13px Arial, Helvetica, sans-serif; font-variant-numeric: tabular-nums;
}
.fn-half-v .fn-head { min-width: 0; display: flex; align-items: center; justify-content: space-between;
  gap: 8px; border-bottom: 3px solid #000; }
.fn-half-v .fn-title { min-width: 0; display: flex; align-items: baseline; gap: 7px; white-space: nowrap; }
.fn-half-v .fn-title strong { font-size: 24px; font-weight: 800; }
.fn-half-v .fn-title span { font-size: 12px; font-weight: 600; }
.fn-half-v .fn-date { text-align: right; min-width: 0; flex: 0 0 auto; }
.fn-half-v .fn-date strong { display: block; font-size: 14px; font-weight: 800; }
.fn-half-v .fn-date small { display: block; font-size: 9px; white-space: nowrap; }
.fn-half-v .fn-current { min-width: 0; display: grid; grid-template-columns: 43% 57%; align-items: center; border-bottom: 1px solid #000; }
.fn-half-v .fn-temp { min-width: 0; }
.fn-half-v .fn-kicker { font-size: 10px; font-weight: 800; letter-spacing: .7px; text-transform: uppercase; }
.fn-half-v .fn-number { font-size: 45px; line-height: 1; font-weight: 800; letter-spacing: -1.1px; white-space: nowrap; }
.fn-half-v .fn-number span { font-size: 17px; letter-spacing: 0; }
.fn-half-v .fn-feels { font-size: 13px; margin-top: 3px; white-space: nowrap; }
.fn-half-v .fn-wind { display: flex; align-items: center; justify-content: flex-end; min-width: 0; gap: 6px; padding-left: 7px; border-left: 1px solid #000; }
.fn-half-v .fn-wind-values { display: grid; grid-template-columns: 1fr 1fr; align-items: start; gap: 7px; flex: 1 1 auto; min-width: 0; }
.fn-half-v .fn-wind-values strong { display: block; font-size: 23px; line-height: 1.1; white-space: nowrap; font-weight: 800; }
.fn-half-v .fn-wind-values small { font-size: 10px; font-weight: 700; }
.fn-half-v .fn-rose { flex: 0 0 65px; width: 65px; text-align: center; }
.fn-half-v .fn-rose svg { display: block; width: 65px; height: 61px; }
.fn-half-v .fn-rose b { display: block; line-height: 1; font-size: 10px; }
.fn-half-v .fn-conditions { display: grid; grid-template-columns: 43% 57%; align-items: center; min-width: 0; border-bottom: 1px solid #000; }
.fn-half-v .fn-rain { min-width: 0; }
.fn-half-v .fn-rain strong { display: block; font-size: 19px; line-height: 1.1; white-space: nowrap; }
.fn-half-v .fn-rain small { display: block; font-size: 10px; }
.fn-half-v .fn-sun { border-left: 1px solid #000; padding-left: 9px; display: flex; align-items: center; justify-content: space-between; gap: 4px; min-width: 0; }
.fn-half-v .fn-sun-item { display: inline-flex; gap: 3px; align-items: center; white-space: nowrap; font-size: 12px; font-weight: 800; }
.fn-half-v .fn-sun svg { width: 21px; height: 21px; display: block; flex: 0 0 21px; }
.fn-half-v .fn-period { display: grid; grid-template-rows: 21px minmax(0, 1fr); min-width: 0; min-height: 0; }
.fn-half-v .fn-period-title { display: flex; justify-content: space-between; align-items: center;
  font-size: 10px; font-weight: 800; letter-spacing: .65px; text-transform: uppercase; }
.fn-half-v .fn-period-title span { font-size: 9px; font-weight: 500; letter-spacing: 0; text-transform: none; }
.fn-half-v .fn-rows { display: grid; min-height: 0; grid-auto-rows: minmax(0, 1fr); }
.fn-half-v .fn-row { display: grid; grid-template-columns: 30% 34% 36%; min-width: 0;
  border-top: 1px solid #000; align-items: center; }
.fn-half-v .fn-cell { min-width: 0; white-space: nowrap; overflow: hidden; }
.fn-half-v .fn-cell:not(:first-child) { padding-left: 4px; }
.fn-half-v .fn-cell b { display: block; font-size: 12px; line-height: 1.13; font-weight: 750; }
.fn-half-v .fn-cell small { display: block; font-size: 10px; line-height: 1.14; margin-top: 2px; }
.fn-half-v .fn-cell.fn-precip b { font-size: 11px; }
.fn-half-v .fn-coast { display: grid; grid-template-columns: 1fr 1fr; align-items: center; border-top: 2px solid #000; }
.fn-half-v .fn-coast > div { min-width: 0; }
.fn-half-v .fn-coast > div + div { border-left: 1px solid #000; padding-left: 12px; }
.fn-half-v .fn-coast strong { display: inline-block; font-size: 24px; line-height: 1.04; font-weight: 800; }
.fn-half-v .fn-coast small { font-size: 11px; padding-left: 4px; white-space: nowrap; }
.fn-half-v .fn-foot { border-top: 1px solid #000; font-size: 9px; display: flex; justify-content: space-between;
  align-items: end; gap: 5px; white-space: nowrap; }
</style>

<div class="layout fn-half-v" aria-label="Wetter Fanø – vertikale Halbansicht">
  <header class="fn-head">
    <div class="fn-title"><strong>Fanø</strong><span>{{ place | escape }}</span></div>
    <div class="fn-date"><strong>{{ updated_date | escape }}</strong><small>Aktualisiert {{ updated_time | escape }} Uhr</small></div>
  </header>

  <section class="fn-current" aria-label="Aktuelle Wetterdaten">
    <div class="fn-temp">
      <div class="fn-kicker">Temperatur</div>
      <div class="fn-number">{{ temp }}<span> °C</span></div>
      <div class="fn-feels">Gefühlt {{ feels }} °C</div>
    </div>
    <div class="fn-wind">
      <div class="fn-wind-values">
        <div><div class="fn-kicker">Wind</div><strong>{{ wind }}</strong><small>Bft</small></div>
        <div><div class="fn-kicker">Böen</div><strong>{{ gust }}</strong><small>Bft</small></div>
      </div>
      <div class="fn-rose" aria-label="Wind aus {{ wind_dir }}">
        <svg viewBox="0 0 90 84" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Windrichtung {{ wind_dir }}">
          <circle cx="45" cy="42" r="25" fill="none" stroke="#000" stroke-width="1.8"/>
          <path d="M45 15V19 M45 65V69 M18 42H22 M68 42H72" fill="none" stroke="#000" stroke-width="2"/>
          <g font-family="Arial, sans-serif" font-size="12" font-weight="800" fill="#000" text-anchor="middle">
            <text x="45" y="11">N</text><text x="81" y="46">O</text>
            <text x="45" y="82">S</text><text x="9" y="46">W</text>
          </g>
          {% if wind_deg != nil %}
          <g transform="rotate({{ wind_deg }}, 45, 42)">
            <path d="M45 21 L38 40 L45 35 L52 40 Z" fill="#000"/>
            <path d="M45 36V62" stroke="#000" stroke-width="2"/>
          </g>
          {% else %}
          <text x="45" y="47" font-size="16" text-anchor="middle">–</text>
          {% endif %}
          <circle cx="45" cy="42" r="2.5" fill="#000"/>
        </svg>
        <b>{{ wind_dir }}</b>
      </div>
    </div>
  </section>

  <section class="fn-conditions" aria-label="Regen und Sonne">
    <div class="fn-rain">
      <div class="fn-kicker">Regen nächste 4 Std.</div>
      <strong>{{ rain }} mm</strong><small>{{ rain_label }} Uhr</small>
    </div>
    <div class="fn-sun" aria-label="Sonnenzeiten">
      <span class="fn-sun-item" aria-label="Sonnenaufgang {{ sunrise }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M1.5 18H16.5 M3.5 18a6 6 0 0 1 12 0 M20 16V5 M17 8l3-3 3 3"/>
        </svg>{{ sunrise }}
      </span>
      <span class="fn-sun-item" aria-label="Sonnenuntergang {{ sunset }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M1.5 18H16.5 M3.5 18a6 6 0 0 1 12 0 M20 5V16 M17 13l3 3 3-3"/>
        </svg>{{ sunset }}
      </span>
    </div>
  </section>

  <section class="fn-period" aria-label="Wetter heute">
    <div class="fn-period-title">Heute <span>Vormittag · Nachmittag · Abend</span></div>
    <div class="fn-rows" style="grid-template-rows: repeat(3, minmax(0, 1fr));">
      {% for row in today %}
      <div class="fn-row">
        <div class="fn-cell"><b>{{ row.label }}</b><small>{{ row.sky }}</small></div>
        <div class="fn-cell"><b>{{ row.temp }}</b><small>{{ row.wind }}</small></div>
        <div class="fn-cell fn-precip"><b>{{ row.rain }}</b><small>{{ row.detail }}</small></div>
      </div>
      {% endfor %}
    </div>
  </section>

  <section class="fn-period" aria-label="Wetter morgen und übermorgen">
    <div class="fn-period-title">Vorhersage <span>Nächste 2 Tage</span></div>
    <div class="fn-rows" style="grid-template-rows: repeat(2, minmax(0, 1fr));">
      {% for row in days %}
      <div class="fn-row">
        <div class="fn-cell"><b>{{ row.label }}{% if row.mixed %}*{% endif %}</b><small>{{ row.sky }}</small></div>
        <div class="fn-cell"><b>{{ row.temp }}</b><small>{{ row.wind }}</small></div>
        <div class="fn-cell fn-precip"><b>{{ row.rain }}</b><small>{{ row.detail }}</small></div>
      </div>
      {% endfor %}
    </div>
  </section>

  <section class="fn-coast" aria-label="Nächste Gezeiten in Nordby">
    <div><div class="fn-kicker">Nächste Ebbe · Nordby</div><strong>{{ ebb }}</strong><small>{{ ebb_day }}</small></div>
    <div><div class="fn-kicker">Nächste Flut · Nordby</div><strong>{{ flood }}</strong><small>{{ flood_day }}</small></div>
  </section>
  <footer class="fn-foot"><span>DMI / Open-Meteo{% if mixed %} · * Modellmix{% endif %}</span><span>Regen-%: max. Stunde</span></footer>
</div>
